# Copiá este archivo a .env.local para desarrollo y cargá las mismas variables en Vercel
# (Project → Settings → Environment Variables). Guía completa: docs/CMS-Y-LEADS.md

# ── Blog desde Google Sheets ─────────────────────────────────────────────
BLOG_SHEET_ID=
BLOG_SHEET_GID=0
REVALIDATE_SECRET=

# ── Leads: Supabase (respaldo de todos los formularios) ───────────────────
# Si conectás Supabase desde Vercel → Storage, estas variables se cargan solas.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Leads: Salesforce (solo formulario de contacto) ───────────────────────
# Opción recomendada: Connected App con OAuth "client credentials"
SF_LOGIN_URL=https://TU-DOMINIO.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# Opción simple (sin Connected App): Web-to-Lead con el ID de la organización
SF_ORG_ID=
# Origen del Lead (valor del picklist LeadSource)
SF_LEAD_SOURCE=Web
