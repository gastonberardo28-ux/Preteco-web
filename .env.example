# Copiá este archivo a .env.local para desarrollo y cargá las mismas variables en Vercel
# (Project → Settings → Environment Variables). Ver docs/CMS-Y-LEADS.md.

# ── Blog desde Google Sheets ─────────────────────────────────────────────
# ID de la planilla "Preteco · Blog (CMS)" (lo que está entre /d/ y /edit en la URL)
BLOG_SHEET_ID=
# Pestaña a leer (0 = la primera)
BLOG_SHEET_GID=0
# Clave para publicar al instante desde el menú de la planilla
REVALIDATE_SECRET=

# ── Leads del formulario ────────────────────────────────────────────────
# URL /exec del Apps Script de la planilla "Preteco · Leads del sitio"
LEADS_WEBHOOK_URL=
# Misma clave que la propiedad SECRET del Apps Script
LEADS_WEBHOOK_SECRET=
